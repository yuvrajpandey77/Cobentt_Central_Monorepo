// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id String @id @default(uuid())
  name String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  screenshot Bytes?
  screenshotMime String?
  
  // Blockchain fields
  projectType ProjectType @default(WEBSITE)
  blockchain Blockchain?
  contractType ContractType?
  contractAddress String?
  network Network?
  tokenName String?
  tokenSymbol String?
  tokenSupply String?
  decimals String?
  features String[] // Array of enabled features like ["mintable", "burnable"]
  buildJobs BuildJob[]
  
  // NEW: Store enhanced AI configuration
  aiConfiguration Json? // Store full EnhancedContractConfig
  gasOptimizations String[] // AI-suggested optimizations
  securityNotes String[] // AI security recommendations
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

 
model Message {
  id String @id @default(uuid())
  content String
  role MessageRole
  type MessageType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fragments Fragment?
  projectId String 
  project Project @relation(fields: [projectId] , references: [id], onDelete: Cascade)
}

model Fragment {
  id String @id @default(uuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id] , onDelete: Cascade)

  sandboxUrl String
  title String
  files Json


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

// Blockchain-related enums
enum ProjectType {
  WEBSITE
  DAPP
  SMART_CONTRACT
}

enum Blockchain {
  ETHEREUM
  POLYGON
  ARBITRUM
  OPTIMISM
  SOLANA
}

enum ContractType {
  ERC20
  ERC721
  ERC1155
  PAYMENT_SPLITTER
  CUSTOM
}

enum Network {
  MAINNET
  TESTNET
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  GENERATE
  COMPILE
  DEPLOY
  VERIFY
}

model BuildJob {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type JobType
  status JobStatus
  logs String? @db.Text
  artifacts Json? // Store ABI, bytecode, deployment info
  contractAddress String?
  transactionHash String?
  progress Int @default(0) // 0-100
  currentStep String? // Current step description
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}