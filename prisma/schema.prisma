// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations/DDL. Neon pooler endpoints
  // can be flaky for schema changes, so Prisma uses this when available.
  directUrl = env("DIRECT_URL")
}

model Project {
  id String @id @default(uuid())
  name String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  screenshot Bytes?
  screenshotMime String?
  
  // Blockchain fields
  projectType ProjectType @default(WEBSITE)
  blockchain Blockchain?
  contractType ContractType?
  contractAddress String?
  network Network?
  tokenName String?
  tokenSymbol String?
  tokenSupply String?
  decimals String?
  features String[] // Array of enabled features like ["mintable", "burnable"]
  buildJobs BuildJob[]
  
  // NEW: Store enhanced AI configuration
  aiConfiguration Json? // Store full EnhancedContractConfig
  gasOptimizations String[] // AI-suggested optimizations
  securityNotes String[] // AI security recommendations
  
  // Token usage tracking
  tokenUsage TokenUsage[]

  // Pin / ordering
  isPinned       Boolean    @default(false)

  // Public visibility & template fork tracking
  isPublic       Boolean    @default(false)
  forkedFromId   String?
  forkedFrom     Project?   @relation("ProjectForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks          Project[]  @relation("ProjectForks")

  @@index([isPublic])
  @@index([userId, isPublic])
  @@map("projects")
}

model Conversation {
  id         String    @id @default(uuid())
  title      String?
  userId     String
  mode       String    @default("chat")
  model      String    @default("openai/gpt-4o-mini")
  template   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isPinned   Boolean   @default(false)
  isArchived Boolean   @default(false)
  isPublic   Boolean   @default(false)
  shareToken String?   @unique
  messages   Message[]
  attachments Attachment[]

  @@index([userId, updatedAt])
  @@index([isPublic])
  @@map("conversations")
}

model Attachment {
  id             String      @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  fileName       String
  mimeType       String
  size           Int
  blob           Bytes
  extractedText  String?     @db.Text
  createdAt      DateTime    @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("attachments")
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETE
  ERROR
  CANCELLED
}

model Message {
  id String @id @default(uuid())
  content String
  role MessageRole
  type MessageType
  status MessageStatus @default(COMPLETE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fragments Fragment?
  
  // Project messages (existing)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Chat messages (new)
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Message tree for branching/regeneration
  parentMessageId String?
  parentMessage Message? @relation("MessageTree", fields: [parentMessageId], references: [id])
  replies Message[] @relation("MessageTree")

  // Metadata
  modelUsed String?
  tokenCount Int?
  feedbackValue Int?

  // Thinking traces & sources (from cobentt_landing chat)
  thinking Json?   @default("[]")
  sources  Json?   @default("[]")

  // Attachments referenced by this message: [{ id, fileName, size }]
  attachments Json?

  tokenUsage TokenUsage[]

  @@index([conversationId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
  @@map("messages")
}

model Fragment {
  id String @id @default(uuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id] , onDelete: Cascade)

  sandboxUrl String?
  title String
  files Json

  mode String?
  meta Json?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fragments")
}

// Blockchain-related enums
enum ProjectType {
  WEBSITE
  DAPP
  SMART_CONTRACT
}

enum Blockchain {
  ETHEREUM
  POLYGON
  ARBITRUM
  OPTIMISM
  SOLANA
}

enum ContractType {
  ERC20
  ERC721
  ERC1155
  PAYMENT_SPLITTER
  CUSTOM
}

enum Network {
  MAINNET
  TESTNET
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  GENERATE
  COMPILE
  DEPLOY
  VERIFY
}

model BuildJob {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type JobType
  status JobStatus
  logs String? @db.Text
  artifacts Json? // Store ABI, bytecode, deployment info
  contractAddress String?
  transactionHash String?
  progress Int @default(0) // 0-100
  currentStep String? // Current step description
  sandboxId String? // E2B sandbox ID for the build environment
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
  @@index([status, createdAt])
  @@map("build_jobs")
}

// ============================================================
// TOKEN USAGE & QUOTA SYSTEM
// ============================================================

enum AllowedUserStatus {
  PENDING
  APPROVED
  REVOKED
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
  CUSTOM
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  OPENROUTER
  GOOGLE
  DEEPSEEK
  QWEN
  CUSTOM
}

enum WebhookEventType {
  QUOTA_WARNING_90
  QUOTA_WARNING_100
  QUOTA_EXCEEDED
  LIMIT_CHANGED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  role         String    @default("SUPER_ADMIN")
  clerkUserId  String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model AllowedUser {
  id                   String              @id @default(uuid())
  email                String              @unique
  userId               String?
  clerkUserId          String?             @unique
  status               AllowedUserStatus   @default(PENDING)
  plan                 UserPlan            @default(FREE)
  invitedBy            String?
  invitedAt            DateTime            @default(now())
  approvedAt           DateTime?
  
  // Quota limits (per day)
  maxDailyRequests     Int                 @default(6)
  maxDailyTokens       Int                 @default(200000)
  
  // Grace period settings
  graceTokens          Int                 @default(20000) // 10% grace
  graceUsed            Boolean             @default(false)
  graceResetAt         DateTime?
  
  // Lifetime limits
  totalRequestsAllowed Int?                // null = unlimited
  
  // Webhook configuration
  webhookUrl           String?
  webhookSecret        String?
  webhookEvents        String[]            @default([])
  
  // Billing (Razorpay)
  razorpayCustomerId   String?
  razorpaySubscriptionId String?
  billingEmail         String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  subscriptionStatus   SubscriptionStatus  @default(ACTIVE)
  
  // Audit
  lastPaymentAt        DateTime?
  lastPaymentId        String?
  // Which paid tier ("starter" | "plus" | "pro") is active; plan stays PRO for every paid tier.
  planKey              String?

  // Legacy Stripe fields (kept for migration, unused)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  payments             PaymentRecord[]
  
  @@index([clerkUserId])
  @@map("allowed_users")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  PAUSED
}

model PaymentRecord {
  id                   String              @id @default(uuid())
  clerkUserId          String
  allowedUserId        String?
  
  // Razorpay identifiers (immutable)
  razorpayOrderId      String              @unique
  razorpayPaymentId    String?             @unique
  razorpaySubscriptionId String?
  
  // Payment details
  amount               Int                 // in paise
  currency             String              @default("INR")
  plan                 UserPlan
  billingCycle         String              @default("monthly")
  // What was bought: "topup:t1" | "topup:t2" | "topup:t3" (plans renew through subscriptions). Null = legacy order.
  product              String?
  
  // Status tracking
  status               PaymentStatus       @default(CREATED)
  receipt              String?
  
  // Verification
  verifiedAt           DateTime?
  signatureVerified    Boolean             @default(false)
  
  // Refund
  refundId             String?
  refundAmount         Int?
  refundReason         String?
  refundedAt           DateTime?
  refundStatus         RefundStatus?
  
  // Subscription period
  periodStart          DateTime?
  periodEnd            DateTime?
  
  // Audit
  correlationId        String?
  ipAddress            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  allowedUser          AllowedUser?        @relation(fields: [allowedUserId], references: [id])
  auditLogs            PaymentAuditLog[]
  
  @@index([clerkUserId, createdAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@map("payment_records")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  EXPIRED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model PaymentAuditLog {
  id                   String              @id @default(uuid())
  paymentRecordId      String?
  clerkUserId          String?
  
  // Event details
  event                String              // e.g. "order.created", "payment.captured", "refund.initiated"
  actor                String              // "system", "user", "admin", "webhook"
  
  // Context
  razorpayOrderId      String?
  razorpayPaymentId    String?
  correlationId        String?
  ipAddress            String?
  
  // Result
  success              Boolean             @default(true)
  details              Json?
  errorMessage         String?
  
  createdAt            DateTime            @default(now())

  paymentRecord        PaymentRecord?      @relation(fields: [paymentRecordId], references: [id])
  
  @@index([clerkUserId, createdAt])
  @@index([razorpayOrderId])
  @@index([event])
  @@map("payment_audit_logs")
}

model UserUsage {
  id            String   @id @default(uuid())
  userId        String   @unique
  
  // Daily counters
  dailyRequests Int      @default(0)
  dailyTokens   Int      @default(0)
  
  // Lifetime counters
  totalRequests Int      @default(0)
  totalTokens   Int      @default(0)
  
  // Cost tracking
  totalCostUsd  Decimal  @default(0) @db.Decimal(10, 2)
  
  // Reset tracking
  lastResetAt   DateTime @default(now())
  
  // Alert tracking
  alert90Sent   Boolean  @default(false)
  alert100Sent  Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tokenUsage    TokenUsage[]

  @@map("user_usage")
}

model TokenUsage {
  id               String     @id @default(uuid())
  userId           String
  projectId        String?
  messageId        String?
  
  // Provider details
  provider         AIProvider
  model            String
  
  // Token counts
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  
  // Cost
  costUsd          Decimal    @db.Decimal(10, 6)
  
  // Metadata
  endpoint         String?    // e.g., "/api/dapp-studio/analyze"
  durationMs       Int?       // response time
  
  createdAt        DateTime   @default(now())

  project          Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  message          Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  userUsage        UserUsage  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([endpoint, createdAt])
  @@map("token_usage")
}

model AdminActionLog {
  id          String   @id @default(uuid())
  adminEmail  String
  clerkUserId String?
  action      String
  targetEmail String?
  changes     Json?
  timestamp   DateTime @default(now())
  ipAddress   String?

  @@index([adminEmail, timestamp])
  @@index([targetEmail, timestamp])
  @@map("admin_action_logs")
}

model WebhookLog {
  id            String   @id @default(uuid())
  userId        String
  eventType     WebhookEventType
  webhookUrl    String
  payload       Json
  responseCode  Int?
  responseBody  String?
  success       Boolean  @default(false)
  attempts      Int      @default(1)
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([success, nextRetryAt])
  @@map("webhook_logs")
}

model UsageAlert {
  id          String   @id @default(uuid())
  userId      String
  alertType   String   // "90_percent", "100_percent", "grace_period"
  message     String
  percentUsed Int
  tokensUsed  Int
  tokenLimit  Int
  sentAt      DateTime @default(now())
  acknowledged Boolean @default(false)

  @@index([userId, sentAt])
  @@map("usage_alerts")
}

// ============================================================
// SETTINGS PLATFORM MODELS
// ============================================================

model ApiKey {
  id             String   @id @default(uuid())
  clerkUserId    String
  provider       String   // openai, anthropic, openrouter, google, deepseek, mistral
  name           String   // user-friendly label
  encryptedKey   String   // AES-256-GCM encrypted
  keyPrefix      String   // first 8 chars for display: "sk-abc1..."
  keySuffix      String   // last 4 chars for display
  iv             String   // initialization vector for AES-GCM
  authTag        String   // GCM auth tag
  isActive       Boolean  @default(true)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clerkUserId])
  @@map("api_keys")
}

model UserProfile {
  id             String   @id @default(uuid())
  clerkUserId    String   @unique
  bio            String?  @db.Text
  company        String?
  website        String?
  location       String?
  timezone       String?
  socialLinks    Json?    // { github, twitter, linkedin }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("user_profiles")
}

model UserAuditLog {
  id             String   @id @default(uuid())
  clerkUserId    String
  event          String   // "profile.updated", "api_key.created", "password.changed", etc.
  actor          String   @default("user") // "user", "system"
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([clerkUserId, createdAt])
  @@index([event, createdAt])
  @@map("user_audit_logs")
}

model AccountDeletionRequest {
  id             String   @id @default(uuid())
  clerkUserId    String   @unique
  status         String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  requestedAt    DateTime @default(now())
  executeAt      DateTime // requestedAt + 30 days grace
  completedAt    DateTime?
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("account_deletion_requests")
}
/// Prepaid balance in "standard tokens" (see src/lib/pricing-catalog.ts). The only thing that pays for hosted AI usage.
model TokenWallet {
  clerkUserId   String    @id
  planST        BigInt    @default(0)
  planExpiresAt DateTime?
  paygST        BigInt    @default(0)
  paygExpiresAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("token_wallets")
}

/// Append-only. `refId` is unique, which makes every grant/reserve/settle idempotent.
model TokenLedger {
  id               String   @id @default(uuid())
  clerkUserId      String
  kind             String   // GRANT_PLAN | TOPUP | RESERVE | SETTLE
  deltaST          BigInt
  fromPlan         BigInt   @default(0)
  fromPayg         BigInt   @default(0)
  refId            String   @unique
  model            String?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime @default(now())

  @@index([clerkUserId, createdAt])
  @@map("token_ledger")
}

/// Razorpay Plan ids for each paid tier and price. Created once through the API, then reused for every subscription.
model RazorpayPlanRef {
  planKey        String
  amountPaise    Int
  razorpayPlanId String   @unique
  createdAt      DateTime @default(now())

  @@id([planKey, amountPaise])
  @@map("billing_razorpay_plans")
}
